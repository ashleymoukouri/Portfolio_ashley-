body{
    font-family: Arial;
    margin:0;
    background:#f4f4f4;
    color:#333;
}

/* HEADER */
header{
    background:#1e3a8a;
    color:white;
    text-align:center;
    padding:30px;
}

/* MENU */
nav{
    background:#0f172a;
    text-align:center;
    padding:15px;
}

nav a{
    color:white;
    text-decoration:none;
    margin:0 15px;
}

/* SECTIONS */
section{
    background:white;
    width:80%;
    margin:20px auto;
    padding:20px;
    border-radius:10px;
    box-shadow:0 2px 8px rgba(0,0,0,0.1);
}

/* PROJETS */
.projet{
    border-left:4px solid #1e3a8a;
    padding-left:10px;
    margin:10px 0;
}

/* FOOTER */
footer{
    text-align:center;
    background:#0f172a;
    color:white;
    padding:20px;
    margin-top:30px;
}
